# ─── Khoá dùng ở MÁY BẠN (trình hướng dẫn tự ghi file .env, không commit) ───
# Chép file này thành .env nếu muốn điền tay. TUYỆT ĐỐI không commit .env.

# Máy chủ AI theo chuẩn OpenAI (OpenAI, OpenRouter, DeepSeek, Ollama, máy chủ riêng…)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# Hoặc dùng Google Gemini API (lấy khoá ở https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Token Telegram của từng bot — tên biến = TELEGRAM_TOKEN_<KEY BOT VIẾT HOA>
# ví dụ bot key "troly" -> TELEGRAM_TOKEN_TROLY
TELEGRAM_TOKEN_TROLY=

# Mật khẩu webhook của từng bot (trình hướng dẫn tự sinh chuỗi ngẫu nhiên)
WEBHOOK_SECRET_TROLY=

# Địa chỉ Worker sau khi deploy, dùng cho `npm run webhook` (không bắt buộc)
WORKER_URL=
