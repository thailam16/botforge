# ─── Dùng cho scripts chạy ở máy bạn (setup wizard, set-webhook) ───
# Wizard sẽ tự ghi file này. KHÔNG commit .env lên GitHub.

# Khoá LLM (điền cái nào bạn dùng)
GEMINI_API_KEY=
OPENAI_API_KEY=
# Base URL cho provider tương thích OpenAI (OpenRouter, DeepSeek, Ollama, gemini-web2api...)
OPENAI_BASE_URL=https://api.openai.com/v1

# Token Telegram của từng bot — tên biến = TELEGRAM_TOKEN_<KEY BOT VIẾT HOA>
# ví dụ bot key "nger" -> TELEGRAM_TOKEN_NGER
TELEGRAM_TOKEN_DEMO=

# Mật khẩu webhook của từng bot (wizard tự sinh chuỗi ngẫu nhiên)
WEBHOOK_SECRET_DEMO=
